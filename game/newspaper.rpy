# Сцена 16: газета.
#
# Что было не так со старым вариантом:
#   1) Заголовки шли как {size=40}{k=3}{b}...{/b}{/k}{/size}.
#      В kazmann-sans.ttf нет отдельного жирного начертания,
#      поэтому Ren'Py рисует фейковый bold: дублирует глиф со
#      сдвигом. На капсе кириллицы буквы наползают друг на
#      друга и превращаются в кашу. Плюс тег {k=3} лез сверху.
#      Итог: заголовок нечитаемый.
#      Тут вместо этого чистый текст, крупный кегль и разрядка
#      через свойство kerning, без фейкового жирного.
#   2) Весь текст выводился одним блоком без скролла и на
#      телефоне гарантированно уезжал за экран.
#      Тут viewport: колесо мыши, стрелки, свайп пальцем.
# ==========================================================


# Размеры текста. Крути тут, если захочешь ещё крупнее.
init python:
    if renpy.variant("small"):
        NEWS_BODY_SIZE = 52
        NEWS_HEAD_SIZE = 60
        NEWS_WIDTH = 1780
    else:
        NEWS_BODY_SIZE = 44   # было 34
        NEWS_HEAD_SIZE = 52
        NEWS_WIDTH = 1560


define NEWSPAPER_TITLE = u"ГУБЕРНСКИЕ ВЕСТИ"

define NEWSPAPER = [

    (u"О ПОГОДЕ: СТУЖА НЕ ЖЕЛАЕТ ОТСТУПАТЬ",
     u"Зима в этом году выдалась на редкость суровой и затяжной. Трескучие морозы, сковавшие реки ещё в ноябре, не спешат покидать наши края, хотя по календарю уже давно должна звенеть капель. На прошлой седмице разыгралась такая пурга, что замело все почтовые тракты. Крестьяне жалуются, что запасы дров на исходе, а выехать в лес за валежником нет никакой возможности: снега намело по самую грудь лошади. Синоптики из столицы предрекают, что потепления не стоит ждать раньше середины апреля."),

    (u"ХЛЕБ НА ИСХОДЕ: ТЯЖЁЛЫЕ ВРЕМЕНА ДЛЯ ГУБЕРНИИ",
     u"Минувший 1970 год оставил тяжёлый след на судьбах наших соотечественников. Засушливое лето привело к страшному неурожаю в большинстве уездов. Озимые помёрзли, а яровые выжгло солнцем. Сейчас, на исходе зимы, крестьянские амбары стоят пустыми. Чтобы хоть как-то прокормить семьи, люди вынуждены подмешивать в скудную ржаную муку лебеду и толчёную древесную кору. Скотину приходится пускать под нож, так как сена для прокорма почти не осталось. Недоимки по податям растут, и многие дворы стоят на грани полного разорения."),

    (u"НАДЕЖДА ИЛИ ПРОКЛЯТИЕ? ТАЙНА ДЕРЕВЕНСКОГО ЛЕКАРЯ",
     u"На фоне голода и холода в уезде вспыхнула новая напасть. Столичные медицинские светила, прибывшие с инспекцией, окрестили неизвестный ранее вирус сухим латинским шифром: JOUL-1. Однако в народе это чужеземное слово быстро переиначили на свой лад. В деревнях хворь прозвали заумно и страшно: «Жгучая Утробная Ломота», или в просторечии «Жулица». Болезнь эта коварна: начинается как обычная простуда, но вскоре человека скручивает так, что ни вздохнуть, ни пошевелиться.\n\nНо на днях в редакцию поступили ошеломляющие вести из глухой таёжной деревеньки Чёрный Ключ. Поговаривают, что живущий там учёный-затворник, бывший профессор столичного университета, чьё имя мы пока не смеем назвать, нашёл спасение. Этот отшельник, обустроивший лабораторию прямо в избе, сумел синтезировать вакцину против «Жулицы». Те немногие крестьяне, кому он дал своё снадобье, вставали на ноги уже на третьи сутки.\n\nОднако сам учёный наотрез отказывается передавать секрет своего эликсира властям или другим врачам. Он заперся в своём деревянном доме, отпугивая незваных гостей собаками, и заявляет, что «мир ещё не готов к последствиям этого лекарства». Что скрывает таинственный профессор и какую цену придётся заплатить за исцеление, пока остаётся загадкой."),
]


screen newspaper(hold_time=6.0):

    modal True
    zorder 200

    add Solid("#0f0c08")

    vbox:
        xalign 0.5
        yalign 0.0
        xsize config.screen_width

        null height 26

        text NEWSPAPER_TITLE:
            xalign 0.5
            size NEWS_HEAD_SIZE
            color "#f2e9d5"
            kerning 8

        null height 10
        add Solid("#5a5140") xsize NEWS_WIDTH ysize 2 xalign 0.5
        null height 18

        viewport id "news_vp":
            xsize NEWS_WIDTH
            ysize config.screen_height - 300
            xalign 0.5
            scrollbars "vertical"
            mousewheel True
            draggable True
            pagekeys True

            vbox:
                spacing 30
                xsize NEWS_WIDTH - 60

                for head, body in NEWSPAPER:

                    vbox:
                        spacing 14

                        text head:
                            xalign 0.5
                            text_align 0.5
                            size NEWS_HEAD_SIZE
                            color "#f7efdc"
                            kerning 2
                            line_spacing 4

                        text body:
                            size NEWS_BODY_SIZE
                            color "#ded3bb"
                            line_spacing 10
                            justify True

                        null height 6
                        add Solid("#3d3629") xsize NEWS_WIDTH - 200 ysize 1 xalign 0.5

                null height 20

        null height 14

        add HoldGate(
            None,
            hold_time,
            hint=u"ЗАЖМИ И ДЕРЖИ, ЧТОБЫ ОТЛОЖИТЬ ГАЗЕТУ",
            text_size=(44 if renpy.variant("small") else 36),
            width=NEWS_WIDTH,
            height=110,
            local_only=True) xalign 0.5
