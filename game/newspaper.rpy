#
# Заголовки НЕ используют {b}: в kazmann-sans нет жирного
# начертания, движок подделывает его сдвигом глифа, и на
# кириллическом капсе буквы наползают в кашу.
# Разрядка сделана через kerning.
# Текст в скроллящемся viewport, за экран не вылезет.
# ==========================================================


# Размеры текста. Крути тут, если захочешь ещё крупнее.
init python:
    if renpy.variant("small"):
        NEWS_BODY_SIZE = 52
        NEWS_HEAD_SIZE = 60
        NEWS_WIDTH = 1780
    else:
        NEWS_BODY_SIZE = 44
        NEWS_HEAD_SIZE = 52
        NEWS_WIDTH = 1560


define NEWSPAPER_TITLE = u"ДОЛИНОВСКИЙ ВЕСТНИК"

define NEWSPAPER = [

    (u"О ПОГОДЕ: СТУЖА НЕ ЖЕЛАЕТ ОТСТУПАТЬ",
     u"Зима в этом году выдалась на редкость суровой и затяжной. Морозы, сковавшие реки ещё в ноябре, не спешат покидать наш район, хотя по календарю давно пора звенеть капели. На прошлой неделе разыгралась такая пурга, что замело просёлочные дороги, автобус до райцентра не ходил трое суток. Жители жалуются на перебои с углём: машину до дальних деревень не пробить, снега намело выше пояса. Синоптики из области предупреждают, что потепления не стоит ждать раньше середины апреля."),

    (u"ПУСТЫЕ ПОЛКИ: ТЯЖЁЛАЯ ЗИМА ДЛЯ РАЙОНА",
     u"Минувший 1990 год оставил тяжёлый след на жизни наших земляков. Засушливое лето обернулось неурожаем почти во всех хозяйствах района. Совхоз «Заря» не выполнил план по зерну и наполовину. Сейчас, на исходе зимы, в магазинах пусто: хлеб по талонам, сахар по талонам, за молоком очередь занимают затемно. Скот в личных хозяйствах пускают под нож, потому что сена до весны всё равно не хватит. Люди держатся на картошке из погреба да на том, что запасли летом."),

    (u"НАДЕЖДА ИЛИ ПРОКЛЯТИЕ? ТАЙНА ТАЁЖНОГО УЧЁНОГО",
     u"На фоне холода и пустых прилавков в районе вспыхнула новая беда. Специалисты из областной больницы, приезжавшие с проверкой, назвали неизвестный ранее вирус сухим латинским шифром: JOUL-1. Но в деревнях это чужое слово быстро переиначили на свой лад и прозвали хворь страшно и заумно: «Жгучая Утробная Ломота», а попросту «Жулица». Болезнь коварна: начинается как обычная простуда, а через несколько дней человека скручивает так, что ни вздохнуть, ни пошевелиться.\n\nНа днях в редакцию поступили удивительные вести из глухой таёжной деревни Чёрный Ключ. Говорят, живущий там затворник, бывший преподаватель областного института, чьё имя мы пока не называем, нашёл спасение. Этот человек оборудовал лабораторию прямо в избе и, по слухам, сумел получить вакцину против «Жулицы». Те немногие, кому он дал своё лекарство, вставали на ноги уже на третьи сутки.\n\nОднако сам он наотрез отказывается передавать состав врачам или властям. Живёт за глухим забором, держит собак, гостей не пускает и повторяет одно: «мир ещё не готов к последствиям этого лекарства». Что скрывает бывший преподаватель и какую цену придётся заплатить за исцеление, пока остаётся загадкой."),
]


screen newspaper(hold_time=6.0):

    modal True
    zorder 200

    add Solid("#0f0c08")

    vbox:
        xalign 0.5
        yalign 0.0
        xsize config.screen_width

        null height 26

        text NEWSPAPER_TITLE:
            xalign 0.5
            size NEWS_HEAD_SIZE
            color "#f2e9d5"
            kerning 8

        null height 10
        add Solid("#5a5140") xsize NEWS_WIDTH ysize 2 xalign 0.5
        null height 18

        viewport id "news_vp":
            xsize NEWS_WIDTH
            ysize config.screen_height - 300
            xalign 0.5
            scrollbars "vertical"
            mousewheel True
            draggable True
            pagekeys True

            vbox:
                spacing 30
                xsize NEWS_WIDTH - 60

                for head, body in NEWSPAPER:

                    vbox:
                        spacing 14

                        text head:
                            xalign 0.5
                            text_align 0.5
                            size NEWS_HEAD_SIZE
                            color "#f7efdc"
                            kerning 2
                            line_spacing 4

                        text body:
                            size NEWS_BODY_SIZE
                            color "#ded3bb"
                            line_spacing 10
                            justify True

                        null height 6
                        add Solid("#3d3629") xsize NEWS_WIDTH - 200 ysize 1 xalign 0.5

                null height 20

        null height 14

        add HoldGate(
            None,
            hold_time,
            hint=u"ЗАЖМИ И ДЕРЖИ, ЧТОБЫ ОТЛОЖИТЬ ГАЗЕТУ",
            text_size=(44 if renpy.variant("small") else 36),
            width=NEWS_WIDTH,
            height=110,
            local_only=True) xalign 0.5
