# ===== Персонажи DLC =====

define artem = Character("Артём", color="#7fb3ff")
define katya = Character("Катя", color="#ff9ec4")
define dima = Character("Дима", color="#9fe07f")

define teacher = Character("Валентина Ивановна", color="#e6d08a")
define biolog = Character("Нина Петровна", color="#cfa8e0")
define olga = Character("Мать Кати", color="#c9c9c9")
define principal = Character("Виктор Николаевич", color="#a8c69a")
define muzhik = Character("Мужик", color="#b8916c")

define dlc_mom = Character("Мама", color="#f0c3a4")
define dlc_dad = Character("Отец", color="#9aa4c4")

define kids = Character("Дети", color="#bbbbbb")
define usher = Character("Билетёрша", color="#bbbbbb")
define duty = Character("Дежурная", color="#bbbbbb")
define classmate = Character("Одноклассник", color="#bbbbbb")
define woman_one = Character("Женщина", color="#bbbbbb")
define woman_two = Character("Вторая женщина", color="#bbbbbb")

define voice = Character("Голос", color="#8f8f8f", what_italic=True)
define katya_voice = Character("Голос Кати", color="#ff9ec4")


# ===== Переменные прохождения =====

default dlc_grade = None
default katya_trust = 0
default asked_about_village = False
default sosnovka_trips = 0


# ==========================================================
# ЧАСТЬ 1. ЗИМА
# ==========================================================

label dlc_sosnovka_start:

    call age_gate

    call card_timed("ДЕВЯНОСТЫЕ\n\nСосновка", 4.0)


# ===== КОД 2010 =====
label dlc_ch_urok:

    call card_timed("1991 год, 9 января, город", 4.0)

    $ bg("dlc_s01")
    $ bgm("story.mp3", 3.0)
    $ sfx("school_bell.mp3")
    "Звонок."

    teacher "Здравствуйте, дети! Надеюсь, отдохнули на каникулах?"
    kids "Дааа..."
    teacher "Ну что, кто расскажет, как провёл время?"

    think "Как я мог провести время? Все каникулы снег чистил, курятник вычищал, отцу по хозяйству помогал. Романтика."

    teacher "Артём, давай ты первый."

    think "Вот стыдно-то говорить, как оно было на самом деле. Мама в куранты телевизор об стену расколотила, отец виски открыл, а бутылка возьми да и рванула, всю комнату и гостей окатило. А в два ночи ещё и драка началась."

    artem "Да ничего особенного, Валентина Ивановна. Куранты встретили, часов в полпервого разошлись спать."
    teacher "Ну и славно. Дима, а у тебя как?"
    dima "А я к пацанам рванул, Новый год встречать. По заброшкам лазили, петарды жгли. Нас чуть менты не повязали, еле ноги унесли, хах."
    teacher "Честно, Дима, ни разу не удивил."
    dima "А чё? Зато весело было, не то что некоторые, дома с родителями весь кайф проспали."
    teacher "Дима, ты Новый год встретил так, будто это последний день свободы."
    dima "Ну а..."
    teacher "И, судя по всему, полиция была с этим совершенно согласна."
    dima "Да ладно, главное, выбрались. Никто не спалился."
    teacher "Это, конечно, главное."
    dima "Вот именно. Остальное неважно. Зато весело."
    teacher "Удивительный жизненный принцип."
    dima "Ну... а чё, работает же."

    "Разговор вышел коротким, и это всё, чего хотела Валентина Ивановна? Она же прекрасно знает, что Дима ничего умнее не скажет. Скорее всего, ей просто нужно было поржать перед уроком."


# ===== КОД 2020 =====
label dlc_ch_deeprichastie:

    teacher "Так, ладно, к делу. Открываем тетради, продолжаем тему «Деепричастный оборот». Кто приведёт пример?"
    katya "«Подойдя к заброшенному зданию, Дима снова понял, что делает что-то незаконное»."
    dima "Э, а я тут при чём сразу?"
    katya "При том, что это единственный пример, который тебе подходит."
    dima "Очень смешно."
    katya "Я не шутила."
    teacher "Правильно, Катя. Артём, теперь ты. Что такое деепричастный оборот?"

    menu:

        "Это когда два слова стоят рядом и оба отвечают на один вопрос":
            $ dlc_grade = 2
            artem "Это когда два слова стоят рядом и оба отвечают на один вопрос."
            katya "Ага. А если рядом три слова, это уже сложное предложение?"
            artem "Я так понял, так и сказал."
            teacher "Понятно. Жаль только, что понял ты неправильно."
            artem "Ну... почти же?"
            teacher "Нет, Артём. Даже не почти. Ставлю оценку в журнал."

        "Это такой оборот... ну, который с деепричастием":
            $ dlc_grade = 2
            artem "Это такой оборот... ну, который с деепричастием."
            katya "Опять та же формулировка... мы это ещё в прошлой четверти проходили."
            teacher "Катя, будешь у нас такая умная, дам слово. Дай пока Артёму договорить."
            teacher "А тебе, Артём... оценка в журнал. Заслуженная."

        "Деепричастный оборот, это деепричастие с зависимыми от него словами":
            $ dlc_grade = 5
            $ katya_trust += 1
            artem "Деепричастный оборот, это деепричастие с зависимыми от него словами."
            teacher "Верно."
            katya "Ну наконец-то. Хоть кто-то сегодня открыл учебник."
            artem "Я вообще-то вчера читал..."
            katya "Видимо, очень внимательно."
            teacher "Катя, всё, хватит. Артём ответил правильно."
            artem "Ну и славно."
            teacher "За верный ответ, оценка в журнал. Заслуженная."
            katya "Вот. Теперь хоть придраться не к чему."

        "Это когда предложение начинается с запятой":
            $ dlc_grade = 2
            artem "Это когда предложение начинается с запятой."
            katya "Это вообще-то даже не определение."
            artem "Я знаю..."
            katya "Мы же это проходили. Неужели так сложно запомнить?"
            teacher "Катя, достаточно. Артём, ответ неверный."
            teacher "Оценка в журнал. Заслуженная."

        "Это когда человек что-то делает, пока делает другое":
            $ dlc_grade = 4
            artem "Это когда человек что-то делает, пока делает другое."
            katya "Ну... близко, но не совсем."
            teacher "Смысл ты уловил, Артём, но формулировка гуляет. Как звучит правильное определение?"
            artem "Эм... деепричастие с зависимыми словами?"
            teacher "Вот теперь так. В следующий раз сразу так и говори."
            katya "Ну хоть с подсказки, но додумался."
            teacher "Ставлю четыре. Могло быть и пять."

        "А можно я лучше пример приведу?":
            $ dlc_grade = 5
            $ katya_trust += 1
            artem "«Идя по улице, мальчик слушал музыку»."
            teacher "Хорошо. А где здесь деепричастный оборот?"
            artem "«Идя по улице»."
            katya "Ну наконец-то. А я уже думала, он опять всё перепутает."
            artem "Я старался..."
            katya "Оно и заметно."
            teacher "Ладно, Артём. Пример верный. Оценка в журнал."

    think "В этой четверти надо постараться, чтобы одни четвёрки и пятёрки вышли, тогда мама обещала PlayStation купить, ту самую, что недавно вышла."

    teacher "Так, теперь твоя очередь, Катя."
    katya "Хорошо."
    teacher "Объясни, чем деепричастный оборот отличается от одиночного деепричастия, и как он обособляется на письме. И пример приведи."
    katya "Деепричастие, особая форма глагола, которая обозначает добавочное действие при основном, отвечает на вопросы «что делая?» и «что сделав?». А деепричастный оборот, это уже деепричастие вместе с зависимыми словами. Например: «Подойдя к окну, мальчик посмотрел на улицу», здесь «подойдя к окну» и есть оборот. Он обособляется запятыми независимо от места в предложении. Если стоит в начале..."
    teacher "Достаточно, Катя."
    katya "Я ещё не закончила."
    teacher "Заметила. Ты ответила на вопрос ещё минуту назад."
    katya "Просто хотела объяснить полностью."
    teacher "Ты объяснила даже слишком полно. Правильно, подробно, с примером. Пять."
    katya "Ну вот. Я же говорила, что знаю."
    teacher "А теперь дай, пожалуйста, и другим показать, что они тоже что-то знают."

    "Время будто специально издевалось, тянулось бесконечно, а до звонка оставались считанные минуты. Валентина Ивановна успела опросить человек семь."

    $ sfx("school_bell.mp3")
    "Звонок."


# ===== КОД 2030 =====
label dlc_ch_priglashenie:

    $ bg("dlc_s03")
    katya "Кузнецов!"
    artem "Чего тебе?"
    katya "Слушай, скоро парный проект по биологии. Не хочешь со мной в паре? Можно у меня дома собраться, разобрать тему, с каким шансом атомы вообще сходятся."
    artem "Чего??"
    katya "Ну тема проекта «Атомы»."
    artem "Не, спасибо, Кать."
    katya "Я бы тебе с русским помогла..."
    artem "У меня с ним всё нормально. Правда."

    think "Даже не знаю, что думать. Неужели это просто совпадение, эти её слова про атомы и шанс сойтись... Тьфу, бред какой. Я и Катя? Кто вообще будет встречаться с заучкой."

    katya "Ну пожалуйста... Я уже пятерых спросила, никто не согласился, а свободных в классе больше нет, все разобрались по парам. Пожалуйста, Артём, ну пожалуйста..."

    think "Видимо, я тут единственный, кому её слегка жалко стало."

    artem "Ладно, ладно, хорошо. И где, у тебя дома?"
    katya "Да, деревня Сосновка, улица Советская, дом 42. Жду в воскресенье."
    artem "Далековато... я думал, ты в городе живёшь."

    "На её лице на секунду мелькнуло что-то похожее на обиду, но тут же спряталось за привычной уверенностью."

    katya "Ну так что, придёшь?"
    artem "Ладно, хорошо. Договорились."


# ===== КОД 2040 =====
label dlc_ch_doroga:

    call card_timed("Воскресенье", 4.0)

    $ sosnovka_trips += 1
    $ bg("dlc_s04")
    $ amb("wind.mp3", 3.0, 0.35)
    $ sfx("steps_snow.mp3")

    "Артём шёл по заснеженной дороге в сторону Сосновки уже минут двадцать. Город остался позади, дома вдоль дороги становились всё реже и старее, а сугробы вдоль обочин выше человеческого роста."

    think "И чего меня понесло в такую даль. Мог бы ведь и отказаться ещё раз. Но нет, припёрся как дурак."

    "Впереди показался покосившийся указатель, с облупившейся краской, на котором едва читалось «Сосновка». За ним начиналась сама деревня, десяток домов, растянутых вдоль одной улицы, и тишина, такая плотная, что было слышно, как скрипит снег под ногами."

    think "Странно тут как-то. Ни машин, ни людей. Как будто все разом решили из дома не выходить."

    artem "Улица Советская, дом сорок два..."

    "Навстречу попалась пожилая женщина, закутанная в платок, тащившая санки с вёдрами. Она остановилась, посмотрела на Артёма долгим взглядом, будто пыталась что-то вспомнить, и молча пошла дальше."

    think "Ну и взгляд у неё... как будто я тут чужой. Хотя, наверное, так оно и есть."

    "Дом сорок два стоял чуть особняком от остальных, отгороженный высоким деревянным забором. За ним виднелась крыша, аккуратная, свежевыкрашенная, резко выделяющаяся на фоне соседних покосившихся построек."

    artem "Ну вот и он..."

    think "Дом какой-то... ухоженный. Слишком ухоженный для такой деревни. Как будто не отсюда вообще."


# ===== КОД 2050 =====
label dlc_ch_dom42:

    $ bg("dlc_s05")
    "Артём подошёл к калитке. Замок отсутствовал, только щеколда. Он на секунду замешкался, потом всё же толкнул и вошёл во двор. Снег во дворе был расчищен идеально, ни единого следа, кроме дорожки прямо к крыльцу."

    think "Даже снег у неё, как по линейке. Как будто тут вообще никто не живёт, а просто декорация."

    $ sfx("door.mp3")
    artem "Кать? Это я, Артём..."

    "Тишина. Через несколько секунд за дверью послышались быстрые шаги, и она распахнулась. На пороге стояла Катя, в домашней одежде, с собранными в хвост волосами, совсем не похожая на себя-школьную."

    katya "О, пришёл всё-таки! А я уж думала, ты передумаешь на полпути."
    artem "Почти передумал, если честно. У вас тут дорога, будто на край света ведёт."
    katya "Ну, зато тихо. Заходи давай, холодно ведь."

    $ amb_stop(1.5)
    "Артём переступил порог. В доме пахло свежей выпечкой и почему-то книгами, много книг, стопками вдоль стен, на подоконниках, даже на кухонном столе в прихожей."

    think "Ничего себе... это что, всё она прочитала? Или это мама её так помешана на учёбе?"

    artem "У вас тут прямо библиотека."
    katya "Это мама. Она говорит, что человек без книг, как дом без окон."
    artem "А ты сама-то читаешь всё это?"
    katya "Часть да. Остальное... скорее для вида стоит. Не мой выбор был."

    "Она произнесла последнюю фразу чуть тише, будто случайно проговорилась, и тут же отвернулась, снимая с вешалки его куртку."

    katya "Пойдём, я тебе стол на кухне накрыла. Мама скоро придёт, хотела с тобой познакомиться."
    artem "Познакомиться? Со мной? Зачем..."

    think "Так, это уже как-то слишком серьёзно для школьного проекта. Или у них тут так принято?"

    katya "Она у меня такая. Хочет знать, с кем я... общаюсь."


# ===== КОД 2060 =====
label dlc_ch_kuhnya:

    $ bg("dlc_s06")
    "Кухня оказалась такой же аккуратной, как и весь дом, ни единого пятна на столе, полотенца сложены идеально ровно. На столе уже лежали тетради, учебник по биологии и распечатанные листы с какими-то схемами атомов."

    katya "Садись. Я тут уже начала немного, чтобы времени не терять."
    artem "Ты это... одна уже половину сделала?"
    katya "Ну не половину. Так, черновик накидала. Чтобы было от чего оттолкнуться."
    artem "Кать, тут формулы такие, что я даже не знаю, с какой стороны читать."

    think "Ну вот, опять как на уроке. Она уже всё знает, а мне остаётся только кивать."

    katya "Да ладно тебе, не так страшно. Смотри, вот тут, это просто про то, как электроны располагаются по уровням..."

    "Она наклонилась ближе, показывая пальцем на схему, и Артём вдруг заметил, что говорит она сейчас совсем не так, как в классе. Мягче, без этой вечной колкости."

    artem "А ты чего вот так объясняешь нормально? В школе ты бы уже сказала, что я тупой."
    katya "Ну... там же все смотрят. А тут только ты."
    artem "И чё, стесняешься быть доброй при всех?"
    katya "Не стесняюсь. Просто... не хочу, чтобы подумали, что я мягкая. Такую сразу есть начинают."

    think "Хм. А ведь в этом что-то есть. Может, она правда просто устала строить из себя отличницу."

    artem "Ладно, показывай дальше. Раз уж обещала не считать меня тупым сегодня."
    katya "Ловлю на слове."

    $ katya_trust += 1
    "Следующие минут двадцать они разбирали схему, и, к своему удивлению, Артём начал понимать. Катя объясняла терпеливо, без единого укола, а один раз даже искренне засмеялась над его неудачной шуткой про электроны, «которые бегают, как Дима от полиции»."

    think "Так, стоп. Мне что, реально нравится с ней сидеть? Так, не думать об этом. Это просто проект."


# ===== КОД 2070 =====
label dlc_ch_mat:

    $ sfx("door.mp3")
    "Скрипнула входная дверь. Катя моментально выпрямилась, тетради сами собой оказались сложены аккуратной стопкой, а улыбка сползла с лица, как будто её и не было."

    katya "Это мама. Веди себя... просто нормально, ладно?"

    think "Странная какая-то просьба. Как будто я собирался вести себя ненормально."

    $ bg("dlc_s07")
    $ bgm("tension.mp3", 3.0)
    "В кухню вошла женщина в строгом сером костюме, с идеально уложенными волосами, каких Артём никогда не видел на матерях одноклассников, разве что на завучах. Она окинула его быстрым, оценивающим взглядом, будто читала личное дело."

    olga "Так вот ты какой. Артём, верно?"
    artem "Да, здравствуйте."
    olga "Садись, садись. Не люблю, когда при мне встают, будто я генерал какой."

    "Она села напротив, положив руки на стол ровно, одна на другую, и продолжала смотреть на Артёма с той же изучающей внимательностью."

    olga "Катя мне рассказывала о тебе. Говорит, ты один из немногих, кто хоть иногда думает головой на уроках."
    katya "Мам..."
    olga "Что? Это комплимент, между прочим."

    think "Комплимент, значит. Звучало вообще-то как что-то среднее между похвалой и допросом."

    artem "Спасибо, наверное..."
    olga "Скажи, Артём, а чем твои родители занимаются?"
    artem "Э... папа на заводе, мама в магазине работает."
