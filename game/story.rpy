label ch_final:

    scene black with slowfade
    $ sfx("door.mp3")
    "Я зашёл в свою комнату, как сейв в видеоигре. Дома тепло, уютно, только вот как сестра..."

    menu:
        "Дать выпить лекарство сестре.":
            pass

    $ bgm_stop(3.0)
    "Была уже ночь. Я подошёл к сестре, сказал ей выпить лекарство. Она сразу же заснула. Была только надежда на то, что она выживет."
    andrey "Спокойной ночи, сестрёнка."

    $ persistent.completed = True
    $ bg("scene_finall")
    $ bgm("credits.mp3", 2.0)
    $ renpy.pause(15.0, hard=True)
    scene black with Fade(3.0, 1.0, 0.0)

