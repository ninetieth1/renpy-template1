define ded = Character("Дед")
define boy = Character("Мальчишка")
define passerby = Character("Прохожий")
define granny = Character("Бабка")
define scientist = Character("Учёный")
define cop = Character("Сотрудник")
define cops = Character("Сотрудники")
define voice_room = Character("Голос из комнаты")
define voice_hut = Character("Голос из избы")
define think = Character(None, what_italic=True)


init python:
    renpy.music.register_channel("ambient", "sfx", loop=True)


init python:
    for _bg in renpy.list_files():
        if _bg.startswith("images/scene_") and _bg.endswith(".png") and "/" not in _bg[len("images/"):]:
            renpy.image(_bg[len("images/"):-4],
                        Transform(_bg, xysize=(1920, 1080), fit="cover", align=(0.5, 0.5)))


init python:

    def sfx(name, volume=1.0):
        p = "audio/sfx/" + name
        if renpy.loadable(p):
            renpy.sound.play(p, channel="sound", relative_volume=volume)

    def bgm(name, fade=2.0):
        p = "audio/" + name
        if renpy.loadable(p):
            renpy.music.play(p, channel="music", fadein=fade, loop=True)

    def bgm_stop(fade=2.0):
        renpy.music.stop(channel="music", fadeout=fade)

    def amb(name, fade=2.0, volume=0.4):
        p = "audio/sfx/" + name
        if renpy.loadable(p):
            renpy.music.play(p, channel="ambient", fadein=fade, loop=True)
            renpy.music.set_volume(volume, channel="ambient")

    def amb_stop(fade=2.0):
        renpy.music.stop(channel="ambient", fadeout=fade)


init python:
    def bg(name, trans=None):
        renpy.scene()
        if renpy.has_image(name, exact=True):
            renpy.show(name)
        else:
            renpy.show("black")
        renpy.with_statement(trans if trans is not None else store.smooth)


screen card_screen(msg, tsize=64):
    add Solid("#000000")
    text msg:
        xalign 0.5
        yalign 0.5
        text_align 0.5
        size tsize
        color "#ffffff"
        xsize 1750
        line_spacing 6

label card_timed(msg, secs=4.0, tsize=64):
    scene black with slowfade
    show screen card_screen(msg, tsize)
    $ renpy.pause(secs)
    hide screen card_screen
    return

label card_click(msg, tsize=34):
    scene black with slowfade
    show screen card_screen(msg, tsize)
    pause
    hide screen card_screen
    return


