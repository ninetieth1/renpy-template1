# Совместимый экран помощи для кнопки «Помощь».
# Раньше кнопка существовала, но экран help отсутствовал.

screen help():
    tag menu

    use game_menu(_("Помощь"), scroll="viewport"):
        vbox:
            spacing 24

            text _("Управление"):
                size 42
                color "#00b3ff"

            text _("Левая кнопка мыши: продолжить диалог или выбрать пункт"):
                size 30
            text _("Правая кнопка мыши: открыть меню"):
                size 30
            text _("Колёсико мыши: прокрутить текст или историю"):
                size 30
            text _("Клавиша Esc: открыть меню"):
                size 30

            null height 20

            text _("Во время игры можно сохранять прогресс, загружать сохранения и менять настройки звука и текста."):
                size 30

